---
config:
  theme: base
  themeVariables:
    fontFamily: Arial, sans-serif
    fontSize: 16px
    primaryColor: '#eef0e4'
    primaryTextColor: '#243c30'
    primaryBorderColor: '#7e9274'
    lineColor: '#7a8b73'
  block:
    padding: 32
---
block-beta
  columns 3

  UI["READING ROOM<br/>React + TypeScript browser UI<br/>Chat · people · natal SVG + tables"]
  API["LOCAL PYTHON SERVER<br/>Same-origin HTTP + SSE<br/>Sessions · CSRF · origin guard"]
  OTHER["CLI / MCP STDIO<br/>Alternative local entry points<br/>Exclusive archive ownership"]

  DB[("POSTGRESQL IN DOCKER<br/>Original conversations + events<br/>People · versions · lineage")]
  TURN["CONVERSATION GATEWAY<br/>Save input before inference<br/>Save output before delivery"]
  TOOLS["APPLICATION SERVICES<br/>Charts · references · personal context<br/>Search · corrections · deletion"]

  FILES["PRIVATE LOCAL FILES<br/>Attachments · credentials<br/>Deletion journal · backups"]
  CONTEXT["BOUNDED CONTEXT<br/>Selected ancestry + summary<br/>Per-turn people / chart versions"]
  ENGINES["CALCULATION / RETRIEVAL<br/>Swiss Ephemeris · natal + solar<br/>Offline bounded hybrid search"]

  QWEN["LOCAL QWEN MODEL<br/>Small synthetic test fixture<br/>Not a quality astrology model"]
  MODEL["MODEL CONNECTION<br/>Local fixture OR ChatGPT plan<br/>Our archive stays authoritative"]
  OPENAI["OPTIONAL OPENAI CLOUD<br/>Account sign-in + Responses<br/>Selected context sent externally<br/>Live use user-reported"]

  UI --> API
  API --> TURN
  OTHER --> TOOLS
  TURN --> DB
  TURN --> TOOLS
  TURN --> CONTEXT
  DB --- FILES
  TOOLS --> ENGINES
  CONTEXT --> MODEL
  MODEL --> QWEN
  MODEL -.-> OPENAI

  classDef ui fill:#1c4231,color:#faf8eb,stroke:#1c4231,stroke-width:2px;
  classDef core fill:#e1e8d6,color:#243c30,stroke:#6e8662,stroke-width:1.5px;
  classDef storage fill:#e8ece0,color:#344b37,stroke:#8da17c;
  classDef localengine fill:#f2ecdf,color:#67533c,stroke:#b6a185;
  classDef secondary fill:#edf0e9,color:#61715b,stroke:#afbaa5;
  classDef external fill:#f4e7dc,color:#725136,stroke:#b9916d,stroke-dasharray:5 4;
  class UI ui
  class API,TURN,CONTEXT,TOOLS,MODEL core
  class DB,FILES storage
  class ENGINES,QWEN localengine
  class OTHER secondary
  class OPENAI external
